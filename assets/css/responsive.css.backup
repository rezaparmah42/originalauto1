* {
    box-sizing: border-box;
}

@media (max-width: 980px) {
    .header-inner,
    .hero-content,
    .trust-section,
    .brands,
    .services-home,
    .articles-preview,
    .footer-top {
        width: min(96%, 100%);
    }

    .header-inner {
        flex-wrap: wrap;
        justify-content: center;
        gap: 14px;
        padding: 18px 0 12px;
    }

    .main-nav {
        width: 100%;
        justify-content: center;
        flex-wrap: wrap;
    }

    .hero-feature {
        min-height: 120px;
    }
}

@media (max-width: 760px) {
    .header-inner {
        flex-direction: column;
        align-items: stretch;
    }

    .main-nav {
        gap: 16px;
    }

    .hero-professional {
        padding: 60px 0 48px;
    }

    .hero-content h1 {
        font-size: 2.4rem;
    }

    .hero-content .hero-features,
    .trust-section,
    .cards {
        grid-template-columns: 1fr;
    }

    .cta {
        padding: 36px 22px;
    }

    .footer-top {
        gap: 22px;
    }
}

@media (max-width: 520px) {
    .btn-outline,
    .btn-primary {
        width: 100%;
    }

    .header-inner {
        padding: 16px 0;
    }

    .brand-name {
        font-size: 1.2rem;
    }

    .footer-top {
        padding-bottom: 10px;
    }
}
