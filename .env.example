# Original Shargh Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Environment
APP_ENV=production
APP_DEBUG=false
APP_URL=https://originalauto.ir
APP_KEY=replace-with-production-secret-key

# Database Configuration
DB_HOST=localhost
DB_NAME=h420462_Originalauto
DB_USER=h420462_Originalauto_user
DB_PASS=

# Site Configuration
SITE_NAME=اورجینال شرق
SITE_PHONE=+98 21 1234 5678
SITE_EMAIL=info@originalshargh.com
SITE_ADDRESS=Tehran, Iran

# File Upload Settings
UPLOAD_MAX_SIZE=5242880
ALLOWED_UPLOAD_TYPES=jpg,jpeg,png,gif,webp

# Email Configuration (optional)
MAIL_DRIVER=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
